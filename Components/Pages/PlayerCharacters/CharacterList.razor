@page "/characters"
@rendermode InteractiveServer
@attribute [Authorize]
@inject CharacterService CharacterService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Player Characters - DnD Manager</PageTitle>

<div class="card">
  <div class="card-header">
    <h1>Player Characters
      <a href="#" class="btn btn-outline-secondary btn-lg border-0 float-end font-weight-bold">
        <i class="bi bi-plus-lg"></i>
      </a>
    </h1>
  </div>
  <div class="card-body">
    <div class="row">
      @if (Characters != null)
      {
        @foreach (var character in Characters)
        {
          <div class="col-lg-4 col-md-6 col-sm-12">
            <div class="card mb-3">
              <a href="/characters/@character.Id" class="text-decoration-none text-dark">
                <div class="card-body d-flex align-items-center">
                  <img src="@DefaultImageUrl" class="img-thumbnail me-3" style="width: 80px; height: 80px; object-fit: cover;" />
                  <div class="text-nowrap text-truncate">
                    <h4 class="card-title d-inline">@character.Name</h4>
                    <br />
                    <p class="card-text text-muted d-inline">
                      @foreach (var charClass in character.CharacterClasses)
                      {
                        @($" {charClass.Class.Name} {charClass.Level} ")
                      }
                    </p>
                  </div>
                </div>
              </a>
              <div class="card-footer text-center">
                <a href="/characters/@character.Id" class="btn btn-outline-secondary btn-lg border-0 me-2">
                  <i class="bi bi-eye-fill"></i>
                </a>
                <a href="#" class="btn btn-outline-secondary btn-lg me-2 border-0">
                  <i class="bi bi-pencil-square"></i>
                </a>
                <button class="btn btn-outline-secondary btn-lg me-2 border-0"
                        @onclick="() => CopyCharacter(character.Id)">
                  <i class="bi bi-copy"></i>
                </button>
                <button class="btn btn-outline-danger btn-lg border-0"
                        @onclick="() => DeleteCharacter(character.Id)">
                  <i class="bi bi-trash-fill"></i>
                </button>
              </div>
            </div>
          </div>
        }
      }
    </div>
  </div>
</div>

@code {
    private List<Character>? Characters;
    private string? currentUserId;
    private string DefaultImageUrl = "https://cdn.pixabay.com/photo/2015/10/05/22/37/blank-profile-picture-973460_1280.png";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (currentUserId != null)
        {
            Characters = await CharacterService.GetCharactersByUserAsync(currentUserId);
        }
    }

    private async Task CopyCharacter(int id)
    {
        if (currentUserId == null) return;
        await CharacterService.CopyCharacterAsync(id, currentUserId);
        Characters = await CharacterService.GetCharactersByUserAsync(currentUserId);
    }

    private async Task DeleteCharacter(int id)
    {
        if (currentUserId == null) return;
        if (!await CharacterService.IsCharacterOwnerAsync(id, currentUserId)) return;
        await CharacterService.DeleteCharacterAsync(id);
        Characters = await CharacterService.GetCharactersByUserAsync(currentUserId);
    }
}
